# Mocks ativos por padrão, inclusive no build de demonstração.
VITE_ENABLE_MOCKS=true
# Com mocks desativados, apontar para um backend que implemente os contratos.
VITE_API_BASE_URL=/api

# Backend Socket.IO compatível quando os mocks estiverem desativados.
# VITE_SOCKET_URL=https://api.exemplo.test
